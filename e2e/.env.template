# OpenAN Integration Test Environment Variable Contract (template)
# Usage: copy e2e/.env.template to e2e/.env and fill in real values for your environment; committing .env to the repository is prohibited.
# Grouping is described in the OpenAN Integration Testing Process and Framework §6.6.

# ---------- Cluster & Deployment ----------
# Kubernetes cluster access (online Helm mode)
KUBECONFIG=
OPENAN_NAMESPACE=openan
# Deployment mode: online-helm | offline-compose
DEPLOY_MODE=online-helm

# ---------- Service URLs Under Test ----------
# Registry Center (HTTPS, default port 5000)
REGISTRY_CENTER_URL=https://127.0.0.1:5000
# mTLS client certificate (required by Registry Center owner isolation/signature verification)
REGISTRY_CLIENT_CERT=
REGISTRY_CLIENT_KEY=
REGISTRY_CA_CERT=
# For jku allowlist toggle validation (jwk_allowlist in the Registry Center server.conf)
REGISTRY_JWK_ALLOWLIST=
# Orchestration Center (backend 5001 / frontend 3003)
ORCHESTRATION_CENTER_URL=http://127.0.0.1:5001
ORCH_ACCESS_PASSWORD=
# OpenAN Portal (Showroom/Playground)
OPENAN_PORTAL_URL=

# ---------- LLM Dependencies (Registry Center semantic search, Orchestration Center intent/workflow generation) ----------
# Real LLM endpoint (models.yaml + named key injection), or the mock toggle below
LLM_CHAT_API_KEY=
LLM_CHAT_BASE_URL=
LLM_CHAT_MODEL=
# A2A-T SDK standalone LLM configuration (A2AT_LLM_* in the orchestration-center .env)
A2AT_LLM_PROVIDER=openai
A2AT_LLM_MODEL=
A2AT_LLM_API_KEY=
A2AT_LLM_BASE_URL=
# Test determinism toggle: true uses a mock LLM / stub responses
USE_MOCK_LLM=false

# ---------- Sample / Mock Agents ----------
# Sample agent endpoints provided by openan-demo mockagent or Orchestration Center samples
MOCK_AGENTS_HOST=
SAMPLE_AGENTS_HOST=

# ---------- External Database (external MySQL/PostgreSQL in deployment values) ----------
DB_BACKEND=postgresql
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=

# ---------- Images & Artifacts ----------
IMAGE_REGISTRY=ghcr.io/project-openan
IMAGE_TAG=
# Artifact integrity verification (SBOM / image digest)
OPENAN_SBOM_PATH=

# ---------- Execution & Reporting ----------
# Directory for preserving failure scenes (trace/log/screenshots)
EVIDENCE_DIR=evidence
